*.class
*.log
*.pyc
*.swp
*.swo
*~
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
*.tmp
*.bak

# ---------- IDEs ----------
# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/
# VS Code: se ignora todo salvo la configuración compartida útil (F5).
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json

